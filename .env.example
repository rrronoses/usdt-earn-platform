TRON_PRO_API_KEY=your_trongrid_api_key
TRON_NETWORK=mainnet
CRON_SECRET=change-me-long-random

# REQUIRED for production security — long random string (32+ chars)
# Cloudflare Pages → Settings → Environment variables → AUTH_SECRET
AUTH_SECRET=replace-with-long-random-secret-min-32-chars

# Admin login (recommended over defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
